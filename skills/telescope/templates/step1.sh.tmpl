#!/bin/bash
#SBATCH --job-name={{JOB_NAME}}
#SBATCH --account={{ACCOUNT}}
#SBATCH --partition={{PARTITION}}
#SBATCH --time={{S1_TIME}}
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task={{S1_CPUS}}
#SBATCH --mem={{S1_MEM}}
#SBATCH --gres=pfsdir:scratch
#SBATCH --output={{PROJECT}}/logs/step1/job_{{ID}}-%j.out
#SBATCH --error={{PROJECT}}/logs/step1/job_{{ID}}-%j.err

set -euo pipefail
set -x

module load {{CONDA_MODULE}}
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate {{CONDA_ENV}}

PROJECT_PATH="{{PROJECT}}"
SAMPLES_PATH="{{SAMPLES_DIR}}"

# tmp_{{ID}} holds the BAMs handed to step 2; it must survive this job.
mkdir -p "${PROJECT_PATH}/tmp_{{ID}}"

# Everything heavy (staged FASTQ, trimmed FASTQ, the SAM) lives on the job-private
# pfsdir and is discarded at job end. Only the BAM is moved to tmp_{{ID}}.
cp -R "{{CODE_DIR}}/lib" "{{CODE_DIR}}/run.py" \
      "${PROJECT_PATH}/manifests/manifest_{{ID}}.tsv" "${PFSDIR}/"
cd "${PFSDIR}"
mkdir -p output

python run.py \
  --manifest manifest_{{ID}}.tsv \
  --gtf "{{REF_DIR}}/{{GTF}}" \
  --genome "{{REF_DIR}}/{{GENOME}}" \
  --transcript "{{REF_DIR}}/{{TRANSCRIPT}}" \
  --herv_gtf "{{REF_DIR}}/{{HERV_GTF}}" \
  --bowtiew2_idx "{{INDEX_DIR}}/{{BOWTIE2_IDX}}" \
  --workflows BOWTIE \
  --out_dir output \
  --samples_dir "${SAMPLES_PATH}" \
  --n_cores "${SLURM_CPUS_PER_TASK}" \
  --trimgalore_n_cores {{TRIMGALORE_N_CORES}} \
  --telescope_n_cores 1 \
  --seed {{SEED}} \
  --scratch_dir "${PROJECT_PATH}/tmp_{{ID}}" \
  --fastq_mode \
  --sample_check_n_cores {{SAMPLE_CHECK_N_CORES}} && rc=0 || rc=$?

# Copy the bowtie2 logs back even if run.py died. The BAMs are written straight
# to tmp_{{ID}}, so they survive regardless -- but the alignment rates and strand
# calls only exist here, and a failure on one sample must not discard them.
mkdir -p "${PROJECT_PATH}/output/BOWTIE"
if [ -f output/logs.tsv ]; then
  cp output/logs.tsv "${PROJECT_PATH}/output/BOWTIE/logs_{{ID}}.tsv"
fi
if [ -d output/BOWTIE ]; then
  rsync -a output/BOWTIE/ "${PROJECT_PATH}/output/BOWTIE/"
fi

echo "=== BAMs handed to step 2 ==="
ls -l "${PROJECT_PATH}/tmp_{{ID}}/" || true

# Report which samples did not produce a BAM, then surface the failure to Slurm
# only after everything has been copied back.
missing=0
while IFS=$'\t' read -r s _; do
  [ "$s" = "sample" ] && continue
  [ -s "${PROJECT_PATH}/tmp_{{ID}}/${s}.bam" ] || { echo "MISSING bam: $s"; missing=1; }
done < "${PROJECT_PATH}/manifests/manifest_{{ID}}.tsv"

if [ "$missing" -ne 0 ] || [ "$rc" -ne 0 ]; then
  echo "step1 job_{{ID}} FAILED (run.py rc=$rc, missing=$missing)"
  exit 1
fi
